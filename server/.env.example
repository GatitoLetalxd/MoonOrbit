# MoonOrbit Backend Configuration
# Port and network interface
PORT=3000
HOST=0.0.0.0

# Database (PostgreSQL)
# Format: postgresql://[user]:[password]@[host]:[port]/[database]
DATABASE_URL=postgresql://postgres:1234@localhost:5432/moonorbit

# Set to true if connecting to managed PostgreSQL requiring SSL (e.g., Supabase, Neon, RDS)
DATABASE_SSL=false

# Trust reverse proxy headers (X-Forwarded-For, X-Forwarded-Proto) from Nginx/Caddy/Cloudflare
TRUST_PROXY=true

# Storage folder for user avatars (relative or absolute)
AVATAR_ROOT=./avatars

# Environment (development | production)
NODE_ENV=production
